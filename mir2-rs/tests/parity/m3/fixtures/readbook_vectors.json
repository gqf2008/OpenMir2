    "IT-17 \u6279\uFF1A\u5168 8 \u4F8B\u4F1A\u8BDD\u9884\u6302\u94C1\u5251 5001\uFF08MAC_hi=12 \u21D2 HitSpeed=\u002B2\uFF0CWeight=7\uFF09\u002B Defense buff\uFF08banwol \u4F8B\u4E24\u6761 \u21D2 CharStatus=0xC0000000\uFF09\u5E76**\u5148 RecalcAbilitys \u4E00\u6B21**\uFF08\u767B\u5F55\u6001\uFF09\uFF1B\u9884\u5E27\u6392\u7A7A\u6CF5\u51FA\u540E\u4E22\u5F03\uFF0C\u5E27\u9762\u53EA\u542B case\u3002",
