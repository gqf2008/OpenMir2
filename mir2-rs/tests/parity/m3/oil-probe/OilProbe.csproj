<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>oil-probe</AssemblyName>
    <RootNamespace>OilProbe</RootNamespace>
  </PropertyGroup>

  <!--
    **IT-12 祝福油**（StdMode3/Shape4）oracle 实测向量生成器（新目录，不改 eat-probe——
    eat-probe 是 IT-16 第二批的签署对象）。引用**真身** `src/M2Server`，反射调私有
    `PlayObject.ClientUseItems`；抽值用 `ScriptedRandom` 装进 `OpenMir2.RandomNumber.random`
    脚本化；武器 `Desc[14]` 前后全量快照；`RM_ABILITY`/`RM_SUBABILITY`/`RM_WEIGHTCHANGED`
    经 `Operate` 泵成 SM 帧。产物 = `mir2-rs/tests/parity/m3/fixtures/oil_vectors.json`。

    （以下为沿用的 M3 口径说明）：
    引用**真身**（同一份 src/M2Server），反射调**私有** `PlayObject.ClientUseItems`（`PlayObject.Operate.cs:601`）
    与其调用的 `EatItems`（`PlayObject.Base.cs:2047`，StdMode 0 药品分支）。
    截获两类真实下行：
      - **即时帧**：替身 `INetChannel.AddGateBuffer` 收到 `SM_EAT_OK(635)` / `SM_EAT_FAIL(636)`；
      - **延时通知**：`BaseObject.SendMsg` 只入 `MsgQueue`（PriorityQueue），探针按出队序读出
        `RM_HEALTHSPELLCHANGED(10052)` / `RM_WEIGHTCHANGED(10115)` / `RM_MENU_OK(10309)`。
    产物 = mir2-rs/tests/parity/m3/fixtures/eat_vectors.json（Rust 侧用例据此逐字段核对）。

    只读：不连 MySQL、不写任何现网文件（SystemShare.ItemSystem 换成内存表）、不发起任何 socket、不起服务。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\M2Server\M2Server.csproj" />
  </ItemGroup>

</Project>
