<Project Sdk="Microsoft.NET.Sdk">
  <!--
    卡 openmir2-magic-parity：C# 侧对拍金标准生成器（只读引用原版工程，不改一行生产代码）。
    运行方式见 Program.cs 顶部注释；产物落盘到 ../golden/magic/<case>.json。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MagicGolden</AssemblyName>
    <RootNamespace>MagicGolden</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\OpenMir2\OpenMir2.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\M2Server\M2Server.csproj" />
    <!-- **MG-36 ①（2026-11-26）**：`EventProcessor`（`ExecuteInternal` 驱动地图事件的唯一入口）在
         `GameSrv.Word.Threads`，没有更细的工程可引 ⇒ 装置只能整体引 GameSrv（`dotnet build` 0 错误，~20s）。 -->
    <ProjectReference Include="..\..\..\..\..\src\GameSrv\GameSrv.csproj" />
  </ItemGroup>
</Project>
